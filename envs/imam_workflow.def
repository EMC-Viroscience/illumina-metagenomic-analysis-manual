Bootstrap: docker
From: cgr.dev/chainguard/wolfi-base:latest

%files
    # Build from the repository root.
    envs/environment.yml /opt/imam/environment.yml
    scripts/prepare_project.py /prepare_project.py
    scripts/post_process_diamond_v1.0.py /post_process_diamond_v1.0.py
    scripts/build_taxon_dict.py /build_taxon_dict.py
    scripts/bin_reads.py /bin_reads.py
    workflow/snakefile_imam.smk /snakefile_imam.smk
    IMAM_VERSION /IMAM_VERSION

%post
    set -eu

    # This definition targets linux-64 Conda packages.
    if [ "$(uname -m)" != "x86_64" ]; then
        echo "This definition requires an x86_64 build host." >&2
        exit 1
    fi

    # Runtime utilities. Most bioinformatics dependencies come from Conda.
    apk add --no-cache bash ca-certificates coreutils

    # Utilities needed only during the build.
    apk add --no-cache --virtual .imam-build-deps \
        curl gnutar bzip2 findutils

    TARGET_ENV_PATH="/opt/conda/envs/imam"
    export MAMBA_ROOT_PREFIX="/opt/imam-mamba-build"

    mkdir -p /opt/imam-build

    # Download separately so curl errors cannot be hidden by a pipeline.
    curl --fail --location --retry 3 \
        https://micro.mamba.pm/api/micromamba/linux-64/latest \
        --output /opt/imam-build/micromamba.tar.bz2

    tar -xjf /opt/imam-build/micromamba.tar.bz2 \
        -C /opt/imam-build bin/micromamba

    /opt/imam-build/bin/micromamba --no-rc create \
        --yes \
        --strict-channel-priority \
        --prefix "${TARGET_ENV_PATH}" \
        --file /opt/imam/environment.yml

    # Record the resolved packages for inspection and future locking.
    /opt/imam-build/bin/micromamba --no-rc list \
        --prefix "${TARGET_ENV_PATH}" \
        --explicit > /opt/imam/conda-linux-64.explicit.txt

    # Remove package downloads and solver caches.
    /opt/imam-build/bin/micromamba --no-rc clean --all --yes

    # Conservative cleanup: retain libraries, metadata, and Python bytecode.
    rm -rf \
        "${TARGET_ENV_PATH}/share/doc" \
        "${TARGET_ENV_PATH}/share/man" \
        /opt/imam-build \
        "${MAMBA_ROOT_PREFIX}"

    apk del .imam-build-deps

%environment
    export PATH="/opt/conda/envs/imam/bin:${PATH}"
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PYTHONNOUSERSITE=1
    export SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt"

%runscript
    #!/bin/sh
    set -eu

    if [ "${1:-}" = "--version" ]; then
        cat /IMAM_VERSION
        exit 0
    fi

    container="${APPTAINER_CONTAINER:-${SINGULARITY_CONTAINER:-imam.sif}}"
    container="$(basename "$container")"

    echo "IMAM Workflow Container - Version: $(cat /IMAM_VERSION)"
    echo "----------------------------------------------------"
    echo "This container provides a two-step metagenomic analysis workflow."
    echo
    echo "Usage:"
    echo "  apptainer run \"$container\" --version"
    echo
    echo "Workflow Steps:"
    echo "  1. Prepare project directory:"
    echo "     apptainer exec \"$container\" python /prepare_project.py -p <project_dir> ..."
    echo
    echo "  2. Run the Snakemake workflow:"
    echo "     apptainer exec \"$container\" snakemake --snakefile <project_dir>/Snakefile --cores <N>"
    echo

%test
    set -eu

    # Set explicitly because %environment is intended for runtime.
    export PATH="/opt/conda/envs/imam/bin:${PATH}"
    export PYTHONNOUSERSITE=1

    python -c "import Bio; print('Biopython:', Bio.__version__)"

    for tool in \
        snakemake diamond spades.py cd-hit-dup fastp \
        bwa seqkit samtools rsync kaiju
    do
        command -v "$tool" >/dev/null
    done

    snakemake --version
    diamond version
    spades.py --version
    fastp --version
    seqkit version
    samtools --version
    rsync --version

    test -s /IMAM_VERSION
    test -f /snakefile_imam.smk

    echo "IMAM installation smoke tests passed."
